# --- Servidor (nunca expostas ao navegador) ---
# URL do backend (api/). O painel só fala com ele pelo BFF em src/app/api/**.
API_URL=http://localhost:3000
# Validade do cookie do refresh token, em dias (padrão 14).
REFRESH_COOKIE_DAYS=14
# Mesma chave de BFF_SHARED_KEY da API: o BFF repassa o IP real do usuário (limite de login por pessoa, auditoria correta).
BFF_SHARED_KEY=

# --- Públicas (vão para o navegador; não coloque segredos aqui) ---
# Dados de DEMONSTRAÇÃO e sem login. Padrão: desligado. Nunca ligue em produção.
NEXT_PUBLIC_DEMO=false
# Atalho opcional para o chat (botão "Conversas"). Vazio = botão oculto.
NEXT_PUBLIC_CHAT_URL=
# Data de início do piloto (AAAA-MM-DD) para mostrar "dia X de 20". Opcional.
NEXT_PUBLIC_PILOT_START=
# Página /privacidade (LGPD): preencher após validação jurídica.
NEXT_PUBLIC_LGPD_CONTROLADOR=
NEXT_PUBLIC_LGPD_OPERADOR=
NEXT_PUBLIC_LGPD_ENCARREGADO=
NEXT_PUBLIC_LGPD_CONTATO=
