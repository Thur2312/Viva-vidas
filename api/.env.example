# Somente NOMES de variaveis; preencha os valores no seu .env (nunca commitar).

# --- Core ---
PORT=
NODE_ENV=
# Origens EXATAS do navegador, separadas por virgula (ex.: http://localhost:3000). Vazio = nega todas.
CORS_ORIGINS=
FRONTEND_URL=
# Sem default: vazio => links de tenant usam FRONTEND_URL.
TENANT_BASE_DOMAIN=
TRUSTED_PROXY_CIDRS=
VALIDATION_WHITELIST_DISABLED=
TENANT_GUARD_ENFORCE=

# --- Auth (painel: JWT HS256 de 15 min) ---
# Mesma chave no BFF (web). Permite a API usar o IP real do usuario (limite de login e auditoria).
# Em producao e OBRIGATORIA (32+ caracteres): sem ela o boot e recusado.
BFF_SHARED_KEY=
# Quanto tempo (ms) a API guarda o estado do usuario antes de conferir o banco de novo. E o prazo maximo para uma
# redefinicao de senha / desativacao derrubar sessoes abertas. Padrao 5000; teto 60000; 0 desliga o cache.
PANEL_SESSION_CACHE_MS=
# Em producao: minimo 32 caracteres aleatorios, nunca placeholder (o boot e recusado).
SECRETKEY=
# Somente para scripts/create-panel-user.ts (alternativa ao prompt oculto). Nao deixe no .env.
PANEL_USER_PASSWORD=

# --- Database (Prisma/PostgreSQL) ---
DATABASE_URL=

# --- Redis ---
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# --- RabbitMQ (fila de tracking) ---
RABBITMQ_URL=
RABBITMQ_PRIVATE_URL=
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_VHOST=

# --- Meta Ads OAuth / Graph API ---
FB_APP_ID=
FB_APP_SECRET=
FB_REDIRECT_URI=
FB_API_VERSION=

# --- Meta webhooks ---
META_LEADS_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_META_WEBHOOK_SIGNATURE_DISABLED=

# --- Criptografia de tokens em repouso ---
ENCRYPTION_KEY=

# --- Storage S3/MinIO (thumbnails de anuncios) ---
MINIO_PUBLIC_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Sem default no codigo: endpoint e bucket sao obrigatorios para usar storage.
MINIO_BUCKET_NAME=
MINIO_PUBLIC_ACCESS=
MINIO_REGION=

# --- Misc ---
CDN_EDGE_CIDRS=
EDGE_REAL_IP_HEADER=
CRON_WORKERS=
NODE_APP_INSTANCE=

# --- Piloto (agente em modo sombra) ---
PILOT_DATABASE_URL=
PILOT_API_KEY=
# true = o chat tambem precisa mandar x-pilot-timestamp e x-pilot-signature (HMAC-SHA256 de "timestamp.corpo"). Ligar so depois do chat assinar.
PILOT_SIGNING_REQUIRED=
PILOT_TENANT=
PILOT_MODEL=
ANTHROPIC_API_KEY=

# --- Modo e hardening ---
# true = sobe so Config/Throttler/Auth/PanelAuth/Pilot (sem Redis/RabbitMQ). Use: npm run start:pilot
PILOT_ONLY=
# Ex.: 127.0.0.1 para escutar so no loopback
HOST=
# Limite do corpo JSON/urlencoded (padrao 1mb)
BODY_LIMIT=
PILOT_TEST_DATABASE_URL=
PILOT_DB_POOL_MAX=
# Producao: PEM da CA do banco em uma linha (quebras como 
), se o certificado nao for de uma CA conhecida pelo Node.
PILOT_DB_CA=

# --- Piloto: LGPD ---
PILOT_DATA_KEY=
PILOT_DATA_KEY_VERSION=
PILOT_DATA_KEY_V1=
PILOT_PHONE_SALT=
PILOT_RETENTION_MESSAGES_DAYS=
PILOT_RETENTION_DRAFTS_DAYS=
PILOT_RETENTION_LEADS_DAYS=

# --- Chat (saída: envio e disparos) ---
CHAT_API_URL=
CHAT_BRIDGE_KEY=
CHAT_CONNECTION_ID=

# --- Voz / VoIP (docs/voice.md). Tudo opcional: sem chaves o modulo fica 'nao configurado' e falha fechado ---
VOICE_TELEPHONY_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_NUMBER=
VOICE_OPERATOR_PHONE=
VOICE_WEBHOOK_BASE_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
STT_PROVIDER=
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=
VOICE_DNC_ENABLED=
VOICE_CALL_WINDOW=
VOICE_RECORDING_RETENTION_DAYS=
VOICE_TRANSCRIPT_RETENTION_DAYS=

# --- CRM (Pipedrive) ---
# pipedrive = liga a fila de sincronizacao (aplique a migration 008 antes). Vazio = desligado, nada e enfileirado.
CRM_PROVIDER=
# Subdominio da conta (alberto em alberto.pipedrive.com) e token da API (so no .env, nunca no codigo).
PIPEDRIVE_DOMAIN=
PIPEDRIVE_API_TOKEN=
# JSON com os ids das etapas do funil: {"qualificado":12,"reuniao_marcada":13,"compareceu":14}
PIPEDRIVE_STAGE_MAP=
# off = nao roda o worker nesta instancia
CRM_WORKER=

# --- Agenda (Google Calendar) ---
# google = liga a consulta de horarios livres e o agendamento pelo painel. Vazio = desligado.
CALENDAR_PROVIDER=
# Credenciais OAuth2 do app Google e o refresh token da conta do Alberto (docs/google-calendar.md). So no .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Id da agenda (e-mail) ou "primary".
GOOGLE_CALENDAR_ID=
# JSON parcial sobre o padrao: {"days":[1,2,3,4,5],"start":"09:00","end":"18:00","durationMin":30,"minNoticeMin":120,"horizonDays":14,"timezone":"America/Sao_Paulo"}
CALENDAR_RULES=
