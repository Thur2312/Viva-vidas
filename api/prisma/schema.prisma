generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Companies {
  id              String        @id @default(uuid())
  ownerId         String?
  companyName     String?
  status          CompanyStatus @default(ACTIVE)
  subdomain       String
  imageUrl        String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt
  deleted_at      DateTime?     @map("deleted_at")
  cnpj            String?
  cnpjData        Json?         @map("cnpj_data")
  cnpjSyncedAt    DateTime?     @map("cnpj_synced_at")
  address         String?
  cep             String?
  country         String?
  cpf             String?
  deliveryAddress String?
  deliveryCep     String?
  deliveryUf      String?
  fiscalAddress   String?
  fiscalCep       String?
  fiscalUf        String?
  private         Boolean?      @default(false)
  repCPF          String?       @default("")
  repName         String?       @default("")
  rep_phone       String?       @default("")
  tags            String?
  uf              String?
  planId          String?
  timezone        String        @default("America/Sao_Paulo")
  secretKey       String?       @map("secret_key")
  subdomainStatus String?       @map("subdomain_status")

  /// Hierarquia de grupo empresarial. Forma garantida pelo trigger
  /// companies_enforce_group_shape (20270805130000_companies_group_hierarchy):
  ///   raiz : parentId = null, groupId = id
  ///   filha: parentId != null, groupId = parent.groupId, e o pai e raiz
  /// Profundidade maxima 2, entao ancestrais(c) = {c.id, c.parentId}.
  ///
  /// groupId e nullable so para nao obrigar os caminhos de criacao existentes a
  /// pre-gerar UUID — o trigger sempre preenche. Ler via effectiveGroupId().
  parentId     String?     @map("parent_id")
  groupId      String?     @map("group_id")
  /// A empresa entra nos NUMEROS do painel consolidado do grupo? Quem liga e
  /// desliga e o dono da matriz; quem concede a empresa ao grupo e a HDM, entao
  /// desativar NUNCA tira a empresa da lista.
  ///
  /// NAO afeta a COTA: leads, transacoes, storage, triggers e assentos somam
  /// todas as empresas do grupo, ativas ou nao — a empresa esta vinculada e o
  /// gasto sai do mesmo balde. Tambem nao afeta acesso.
  ///
  /// Default true preserva as filhas que ja existiam; vinculo NOVO nasce false,
  /// gravado explicitamente por attachCompanyToGroup e createSubCompany.
  groupActive  Boolean     @default(true) @map("group_active")
  parent       Companies?  @relation("CompanyHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Companies[] @relation("CompanyHierarchy")
  groupRoot    Companies?  @relation("CompanyGroup", fields: [groupId], references: [id], onDelete: Restrict)
  groupMembers Companies[] @relation("CompanyGroup")

  Campaigns                 Campaigns[]
  companyMember             CompanyMember[]
  GenericDnd                GenericDnd[]
  Integrations              Integrations[]
  Leads                     Leads[]
  events                    Events[]
  Tracking                  Tracking[]
  trackingActionConfigs     TrackingActionConfig[]
  trackingActionConfigChanges TrackingActionConfigChange[]
  adsPerformance            AdsPerformance[]
  adsBreakdownPerformance   AdsBreakdownPerformance[]
  adCreativeAnalysis        AdCreativeAnalysis[]
  triggerTrackingEvents     TriggerTrackingEvent[]
  metaOAuthStates           MetaOAuthState[]
  whatsappMessages          WhatsappMessage[]
  whatsappStatusUpdates     WhatsappStatusUpdate[]
  metaLeadFormMappings      MetaLeadFormMapping[]

  /// Indice do consolidado do grupo (WHERE group_id = $1). Declarado aqui com o
  /// `map` do nome real para Prisma e banco nao divergirem. O indice de parent_id
  /// e PARCIAL e fica so no SQL da migration — Prisma nao expressa indice parcial.
  @@index([groupId], map: "idx_companies_group_id")
  /// Escopo de visibilidade (WHERE status = $1 AND deleted_at IS NULL), o
  /// predicado padrao desde que empresa inativa passou a sumir das telas e a ter
  /// o acesso cortado. Ver src/shared/constants/company-scope.ts.
  @@index([status, deleted_at], map: "idx_companies_status_deleted_at")
}

model Contacts {
  id             Int       @id @default(autoincrement())
  organizationId String?
  leadId         Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  remark         String    @default("")
  role           String    @default("")
  type           String    @default("")
  email          String    @default("")
  name           String    @default("")
  phone          String    @default("")
  deleted_at     DateTime? @map("deleted_at")

  // CS/Relationship fields (Tier 1.1 — habilita eventos client.*)
  status          String? @db.VarChar(50)
  onboardingStage String? @db.VarChar(80)
  healthScore     Int?
  nps             Int?
  /// Users.id — TEXT, e NAO uuid (ver UserNotification.userId).
  ownerId         String?

  // Dados pessoais (form)
  photoUrl   String? @map("photo_url")
  birthDay   String? @map("birth_day")
  birthMonth String? @map("birth_month")

  // Endereço
  address    String?
  city       String?
  uf         String?
  cep        String?
  obsEntrega String? @map("obs_entrega")

  // Contato de emergência
  emergencyName     String? @map("emergency_name")
  emergencyRelation String? @map("emergency_relation")
  emergencyPhone    String? @map("emergency_phone")

  // Preferências
  foods            String[] @default([])
  drinksAlcohol    Boolean? @map("drinks_alcohol")
  intolerances     String[] @default([])
  dietRestrictions String[] @default([]) @map("diet_restrictions")
  otherRestriction String?  @map("other_restriction")
  favoriteColor    String?  @map("favorite_color")
  musicGenres      String[] @default([]) @map("music_genres")
  movieGenres      String[] @default([]) @map("movie_genres")

  // Tamanhos
  shirtSize  String? @map("shirt_size")
  pantsSize  String? @map("pants_size")
  shoeSize   String? @map("shoe_size")
  sandalSize String? @map("sandal_size")

  // Relações
  contactOrganizationId String?                 @map("contact_organization_id")
  lead                  Leads?                  @relation(fields: [leadId], references: [id])
}

model CompanyMember {
  id                        Int                        @id @default(autoincrement())
  userId                    String?
  companyId                 String
  role                      CompanyRole                @default(SELLER)
  contractDueDate           DateTime?
  invitedEmail              String?
  status                    CompanyMemberStatus        @default(INVITED)
  username                  String?
  contractStartDate         DateTime?
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @default(now()) @updatedAt
  deleted_at                DateTime?                  @map("deleted_at")
  plan                      PlanCompanyType?           @default(COMPLETE)
  ramal                     String?
  /// OWN = vale so para esta empresa (comportamento historico, default de toda
  /// linha existente). SUBTREE = vale para esta empresa e todas as filhas dela.
  scope                     CompanyMemberScope         @default(OWN)
  /// Membro não-admin pode conectar/gerir o PRÓPRIO número de WhatsApp (conexões
  /// atribuídas a ele). Só OWNER/ADMIN/SUPERADMIN liga; admin conecta sempre.
  canConnectWhatsapp        Boolean                    @default(false) @map("can_connect_whatsapp")
  company                   Companies                  @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
}

model Platforms {
  id              String            @id @default(uuid())
  platformName    String
  details         String?
  image           String?
  testUrl         String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt
  deleted_at      DateTime?         @map("deleted_at")
  type            String?           @default("payment")
  Events          Events[]
  Integrations    Integrations[]
}

model Integrations {
  id                      Int              @id @default(autoincrement())
  platformsId             String
  companiesId             String
  apiKey                  String?
  hottok                  String?
  clientId                String?
  clientSecret            String?
  basic                   String?
  details                 String?
  status                  GeneralStatus    @default(ACTIVE)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @default(now()) @updatedAt
  hotSubdomain            String?
  deleted_at              DateTime?        @map("deleted_at")
  smtpFrom                String?
  smtpHost                String?
  smtpPassword            String?
  smtpPort                String?
  smtpUsername            String?
  platformMemberId        String?
  webhook                 String?
  webhook2                String?
  metaAccessToken         String?
  metaAppId               String?
  metaAppSecret           String?
  metaCronEnabled         Boolean?         @default(false)
  metaCronInterval        Int?             @default(24)
  metaLastSync            DateTime?
  metaFacebookUserId      String?
  metaFacebookName        String?
  metaFacebookEmail       String?
  metaTokenExpiresAt      DateTime?
  metaOAuthConnectedAt    DateTime?
  metaOAuthMethod         MetaOAuthMethod? @default(MANUAL)
  /// Token revogado pelo provedor (OAuthException 190, ex.: troca de senha) — distinto
  /// de expirado por data. Setado na 1ª falha de auth; limpo ao regravar o token.
  metaTokenInvalidAt      DateTime?
  metaTokenInvalidReason  String?
  metaLeadsVerifyToken    String?
  metaLeadsAppSecret      String?
  metaLeadsWebhookEnabled Boolean?         @default(false)
  whatsappVerifyToken     String?
  whatsappAppSecret       String?
  whatsappWebhookEnabled  Boolean?         @default(false)
  webinarApiKey           String?
  imapHost                String?
  imapPort                String?
  imapUsername            String?
  imapPassword            String?
  imapEnabled             Boolean?         @default(false)
  imapLastSync            DateTime?
  fonetalkLastSync        DateTime?
  onvoxLastSync           DateTime?
  /// Sincronização agendada do Asaas. Intervalo em HORAS; o cron confere o cursor em
  /// código (lastSync + intervalo) em vez de usar expressão fixa, o que permite intervalo
  /// arbitrário, escalona as empresas naturalmente e recupera janela perdida após queda.
  asaasCronEnabled        Boolean?         @default(true)
  asaasCronInterval       Int?             @default(1)
  asaasLastSync           DateTime?
  webhookSecret           String?
  company                 Companies        @relation(fields: [companiesId], references: [id])
  platform                Platforms        @relation(fields: [platformsId], references: [id])
}

model Events {
  id               Int              @id @default(autoincrement())
  platformsId      String?
  platformData     Json
  createdAt        DateTime         @default(now())
  deleted_at       DateTime?        @map("deleted_at")
  companyId        String?
  platformMemberId String?
  platform         Platforms?       @relation(fields: [platformsId], references: [id])
  company          Companies?       @relation(fields: [companyId], references: [id])
}

model Customers {
  customerId         Int       @id @default(autoincrement())
  name               String?
  email              String
  phoneNumber        String?
  address            String?
  document           String?
  city               String?
  state              String?
  country            String?
  zipcode            String?
  street             String?
  addressNumber      String?
  neighborhood       String?
  complement         String?
  externalCustomerId String?
  companyId          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  deleted_at         DateTime? @map("deleted_at")
  Leads              Leads[]

  @@index([companyId])
  @@index([email, companyId])
  @@index([phoneNumber, companyId])
}

