  name                 String?
  slug                 String?
  startDate            DateTime?
  endDate              DateTime?
  description          String?
  tags                 String?
  token                String?
  companyId            String
  imageUrl             String?
  billetTotals         Int?                  @default(0)
  cardTotal            Int?                  @default(0)
  hibridTotals         Int?                  @default(0)
  numberSell           Int?                  @default(0)
  receipts             Int?                  @default(0)
  totalApproved        Int?                  @default(0)
  billetsPaid          Int?                  @default(0)
  billetsToday         Int?                  @default(0)
  offersIds            String[]
  prodIds              String[]
  liveUrl              String?
  sellsMonth           Int                   @default(0)
  sellsMonthValue      Float                 @default(0)
  sellsToday           Int                   @default(0)
  sellsTodayValue      Float                 @default(0)
  sellsWeek            Int                   @default(0)
  sellsWeekValue       Float                 @default(0)
  sellsRecovery        Int                   @default(0)
  sellsRecoveryValue   Float                 @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  pixPaid              Int?                  @default(0)
  deleted_at           DateTime?             @map("deleted_at")
  leadProptAI          String?               @default("")
  leadPromptManager    String?               @default("")
  leadAiAgentId        String?               @map("lead_ai_agent_id")
  managerAiAgentId     String?               @map("manager_ai_agent_id")
  countRecurrenceType  String                @default("SALES_ONLY")
  rankingMetric        String                @default("COUNT")
  totalAmount          Decimal               @default(0) @db.Decimal(10, 2)
  slugFilter           Boolean               @default(false)
  showLeadStatsOnTeams Boolean               @default(true)
  columnSetId          String?
  clientesColumnSetId  String?
  csColumnSetId        String?
  trackingApiKey       String?               @unique @map("tracking_api_key")
  leadsApiKey          String?               @unique @map("leads_api_key")
  metaPixelId          String?
  metaLeadsVerifyToken String?               @map("meta_leads_verify_token")
  hdmMetaLeadToken     String?               @unique @map("hdm_meta_lead_token")
  adsLastUpdatedAt     DateTime?             @map("ads_last_updated_at") @db.Timestamptz(6)
