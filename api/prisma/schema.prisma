  value           Float?
  currency        String? @default("BRL")
  contentName     String? @map("content_name") // Meta custom_data.content_name
  contentCategory String? @map("content_category") // Meta custom_data.content_category
  contentIds      String? @map("content_ids") // JSON array string → Meta custom_data.content_ids

  // UTM tracking
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmContent  String? @map("utm_content")
  utmTerm     String? @map("utm_term")

  // Click IDs (NÃO são UTMs — são identificadores de click de plataformas de ads)
  fbc   String? @map("fbc") // Facebook Click ID (formato: fb.1.{ts}.{fbclid}) → Meta user_data.fbc
  gclid String? @map("gclid") // Google Click ID

  // Advanced Matching - dados extras para Meta CAPI
  zipCode         String? @map("zip_code")
  dateOfBirth     String? @map("date_of_birth") // YYYYMMDD com ano real (Meta rejeita ano < 1900)
  birthMonthDay   String? @map("birth_month_day") // MMDD quando o ano e desconhecido → so dobm/dobd
  gender          String? // m ou f
  fbp             String? // Facebook Browser Pixel ID → Meta user_data.fbp
  clientUserAgent String? @map("client_user_agent")
  fbLeadgenId     String? @map("fb_leadgen_id") // Meta Lead Ads leadgen_id (ID único da submissão, NÃO form_id) → Meta user_data.lead_id
  fbPageId        String? @map("fb_page_id") // Meta Page ID → Meta user_data.page_id
  eventSourceUrl  String? @map("event_source_url") // URL onde o evento ocorreu (obrigatorio para action_source=website)

  // Enterprise Meta CAPI - campos extras para EMQ supremo
  orderId        String? @map("order_id") // transactionCode → Meta custom_data.order_id (deduplicação Purchase)
  subscriptionId String? @map("subscription_id") // subscriberCode de recorrência → Meta user_data.subscription_id
  ctwaClid       String? @map("ctwa_clid") // Click-to-WhatsApp Click ID → Meta user_data.ctwa_clid
  predictedLtv   Float?  @map("predicted_ltv") // Valor preditivo do lead → Meta custom_data.predicted_ltv
  leadScore      Int?    @map("lead_score") // Score calculado do lead (0-165) para analytics
  contentType    String? @map("content_type") // "product" ou "product_group" → Meta custom_data.content_type
  igAccountId    String? @map("ig_account_id") // Instagram Account ID → Meta user_data.ig_account_id
  /// Congelado no momento da emissao, nao lido no envio: o evento tem que
  /// refletir a vontade do titular QUANDO o fato aconteceu. Ler no envio faria
  /// uma oposicao registrada hoje reescrever eventos de ontem que ja sairam.
  optOut         Boolean @default(false) @map("opt_out") // → Meta opt_out

  // Facebook Ads data
  adsetId    String? @map("adset_id")
  adsetName  String? @map("adset_name")
  adId       String? @map("ad_id")
  adName     String? @map("ad_name")
  campaignId String? @map("campaign_id")

  // Meta send control
  pixelId       String?   @map("pixel_id") // Meta Pixel ID para envio CAPI
  eventId       String?   @unique @map("event_id") // hash determinístico da ocorrência (dedup Meta + idempotência)
  status        String    @default("PENDING") // PENDING, SENT, FAILED, EXPIRED
  attempts      Int       @default(0) // tentativas de envio já feitas (retry com backoff)
  nextAttemptAt DateTime? @map("next_attempt_at") // backoff: não reenviar antes deste instante
  sentAt        DateTime? @map("sent_at")
  errorMessage  String?   @map("error_message")
  metaResponse  Json?     @map("meta_response") @db.JsonB // Resposta da Meta API (events_received, fbtrace_id, messages, warnings)
  sentPayload   Json?     @map("sent_payload") @db.JsonB // Payload user_data enviado (para debug, SEM access_token)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Companies @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([companyId, status])
  @@index([companyId, eventName])
  @@map("trigger_tracking_event")
}

model MetaOAuthState {
  id        Int       @id @default(autoincrement())
  companyId String
  state     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  company   Companies @relation(fields: [companyId], references: [id])

  @@index([expiresAt])
  @@map("meta_oauth_states")
}

model WhatsappMessage {
  id                 String                   @id @default(uuid())
  companyId          String                   @map("company_id")
  wabaId             String?                  @map("waba_id")
  phoneNumberId      String                   @map("phone_number_id")
  displayPhoneNumber String?                  @map("display_phone_number")
  wamid              String                   @unique
  direction          WhatsAppMessageDirection @default(INBOUND)
  fromNumber         String                   @map("from_number")
  toNumber           String?                  @map("to_number")
  contactName        String?                  @map("contact_name")
  contactWaId        String?                  @map("contact_wa_id")
  messageType        String                   @default("text") @map("message_type")
  content            String?
  rawPayload         Json?                    @map("raw_payload")
  contextMessageId   String?                  @map("context_message_id")
  contextFrom        String?                  @map("context_from")
  status             WhatsAppMessageStatus?   @default(SENT)
  timestamp          DateTime
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime?                @map("deleted_at")
  company            Companies                @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([wamid])
  @@index([fromNumber])
  @@index([phoneNumberId])
  @@index([timestamp])
  @@index([direction])
  @@index([contactWaId])
  @@map("whatsapp_messages")
}

model WhatsappStatusUpdate {
  id                    String                @id @default(uuid())
  companyId             String                @map("company_id")
  wamid                 String
  status                WhatsAppMessageStatus
  recipientId           String                @map("recipient_id")
  phoneNumberId         String                @map("phone_number_id")
  displayPhoneNumber    String?               @map("display_phone_number")
  wabaId                String?               @map("waba_id")
  billable              Boolean?              @default(false)
  pricingModel          String?               @map("pricing_model")
  pricingCategory       String?               @map("pricing_category")
  pricingType           String?               @map("pricing_type")
  bizOpaqueCallbackData String?               @map("biz_opaque_callback_data")
  timestamp             DateTime
  createdAt             DateTime              @default(now()) @map("created_at")
  deletedAt             DateTime?             @map("deleted_at")
  company               Companies             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([wamid])
  @@index([status])
  @@index([recipientId])
  @@index([timestamp])
  @@map("whatsapp_status_updates")
}

