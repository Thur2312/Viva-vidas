  @@unique([companyId, adId, reportStartDate, reportEndDate, breakdownType, breakdownValue])
  @@index([companyId])
  @@index([breakdownType])
  @@index([companyId, reportStartDate, reportEndDate])
  @@index([companyId, adId, reportStartDate])
  @@map("ads_breakdown_performance")
}

