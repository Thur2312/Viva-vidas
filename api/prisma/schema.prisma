model MetaLeadFormMapping {
  id          Int       @id @default(autoincrement())
  formId      String    @map("form_id")
  formName    String?   @map("form_name")
  pageId      String?   @map("page_id")
  pageName    String?   @map("page_name")
  verifyToken String?   @map("verify_token")
  campaignId  String    @map("campaign_id")
  companyId   String    @map("company_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deleted_at  DateTime? @map("deleted_at")

  campaign Campaigns @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)
  company  Companies @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([formId, companyId])
  @@index([campaignId])
  @@index([companyId])
  @@map("meta_lead_form_mapping")
}

model TrackingActionConfig {
  id String @id @default(uuid())

  companyId String @map("company_id")

  /// Escopo da linha. `""` e o padrao da empresa; qualquer outro valor e o
  /// `campaignId` que sobrescreve esse padrao, campo a campo.
  ///
  /// SENTINELA e nao NULL, de proposito: em indice unico do Postgres um NULL nao
  /// conflita com outro, entao daria para inserir DOIS padroes da mesma acao e
  /// quebrar em silencio a invariante "um padrao por acao". O PG 15 tem
  /// `NULLS NOT DISTINCT`, mas o Prisma nao declara isso no `@@unique` (o indice
  /// ficaria em drift) e o `upsert` compara com `=`, que nunca casa com NULL.
  ///
  /// O preco e nao ter FK para `Campaigns`. Aceitavel: campanha usa soft delete,
  /// entao orfao praticamente nao acontece, e a tela so lista campanha viva.
  campaignId String @default("") @map("campaign_id")

  /// Valor CRU de `Tracking.action`, sempre em minusculo. A tabela convive com
  /// `OPTIN` e `optin` (so 1 dos 5 caminhos de escrita chama normalizeAction),
  /// entao a chave e normalizada aqui e o lookup baixa a caixa antes.
  action String

  /// Rotulo amigavel para as telas. Sem isto, a UI cai no prettifyActionName.
  label String?

  /// Nome enviado no `event_name` da Meta. NUNCA entra no `event_id`: o hash usa
  /// o nome observado, senao trocar o mapeamento reenviaria toda conversao ja
  /// enviada.
  metaEventName String? @map("meta_event_name")

  /// Peso em BRL que vai como `custom_data.value`. Tracking nao tem preco, entao
  /// sem isto o evento chega na Meta sem valor nenhum e o algoritmo nao aprende
  /// que "assistiu 90%" vale mais que "assistiu 10%".
  eventValue Float? @map("event_value")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Companies @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, campaignId, action])
  @@index([companyId])
  @@index([companyId, campaignId])
  @@map("tracking_action_config")
}

model TrackingActionConfigChange {
  id String @id @default(uuid())

  companyId String @map("company_id")

  /// Mesmo escopo da linha editada: `""` e o padrao da empresa, qualquer outro
  /// valor e o `campaignId`. Sem FK para `Campaigns` pelo mesmo motivo da
  /// tabela de config — a sentinela `''` nao tem campanha correspondente. O nome
  /// da campanha sai do `labelFor` no cliente.
  campaignId String @default("") @map("campaign_id")

  /// Acao editada, na mesma forma normalizada da `tracking_action_config`.
  action String

  /// CREATED | UPDATED | DELETED.
  changeType String @map("change_type")

  /// `{ campo: { before, after } }`, so com os campos que realmente mudaram.
  /// Mesmo contrato do `TransactionAuditLog.changedFields`.
  changedFields Json @default("{}") @map("changed_fields")

  /// Desnormalizados de proposito, como no `TriggerBodyChangeLog`: usuario
  /// removido nao pode apagar o rastro de quem editou.
  userId    String? @map("user_id")
  userName  String? @map("user_name")
  userEmail String? @map("user_email")

  /// `ip_address` vem do `resolveClientIp`, que varre o `X-Forwarded-For` da
  /// direita para a esquerda. Ler a ponta esquerda deixaria qualquer um forjar
  /// o IP no historico.
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  company Companies @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, action, createdAt(sort: Desc)])
  @@map("tracking_action_config_changes")
}

model Leads {
  id              Int       @id @default(autoincrement())
  name            String
  email           String?
  phone           String?
  campaignId      String?
  interested      Boolean   @default(false)
  status          String?   @db.VarChar(50) // Tier 1.2: ciclo de vida do lead (NEW, QUALIFIED, DISQUALIFIED, CONVERTED, ...)
  state           String?
  city            String?
  leadIp          String?
  sellerId        Int?
  /// Quando `sellerId` passou a valer o que vale hoje. Base do SLA de primeiro toque e
  /// do "atribuído há X min" no painel. Nulo em todo lead que nunca teve dono.
  assignedAt      DateTime? @db.Timestamptz(6)
  /// Primeira interação do dono com o lead depois de recebê-lo. Enquanto for nulo e
  /// `assignedAt` estiver vencido, o SLA devolve o lead.
  firstTouchAt    DateTime? @db.Timestamptz(6)
  dndColumnId     String?
  dndColumnOrder  Int?
  customerId      Int
  isStudent       Boolean   @default(false)
  utms            String?
  utm_campaign    String?
  utm_content     String?
  fbc             String?
  gclid           String?
  utm_medium      String?
  utm_source      String?
  utm_term        String?
  utm_var1        String?
  created_at      DateTime? @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  companyId       String?
  deleted_at      DateTime? @map("deleted_at")
  atendente       String?
  canal           String?
  link_chat       String?
  externalUserId  String?
  source          String?
  organizationId  String?
  data_agendada   String?
  meet_link       String?
  analysis        String?
  analysisManager String?
  analyzedDomain  String?
  analyzedCountry String?
  instagramUrl    String?
  linkedinUrl     String?
  facebookUrl     String?
  youtubeUrl      String?
  history_details String?
  var             Boolean   @default(false)

  // Dados do diagnóstico
  fbclid         String?
  fbp            String? // Facebook Browser Pixel ID (cookie _fbp)
  empresa        String?
  cargo          String?
  source_url     String?
  /// Quando o titular se opos ao tratamento dos dados dele (LGPD, art. 18).
  ///
  /// Preenchido vira `opt_out: true` no evento Meta CAPI: a Meta passa a usar a
  /// conversao SO para atribuicao, nunca para otimizacao de campanha nem para
  /// publico. O evento continua sendo enviado e continua contando no relatorio —
  /// a pessoa e que deixa de virar alvo.
  ///
  /// NAO confundir com Limited Data Use (`data_processing_options`), que e
  /// mecanismo de leis da California, Colorado e Connecticut e nao se aplica a
  /// base brasileira.
  optOutAt       DateTime? @map("opt_out_at")
  /// Quem registrou a oposicao. Nulo quando veio de script ou do proprio titular.
  optOutBy       String?   @map("opt_out_by")
  origin_url     String? // Origem observada pelo servidor (header Referer/Origin) — separada de source_url (declarada pelo cliente)
  origin_type    String? // Camada que resolveu a origem: web | api | webhook
  faturamento    String?
  score_total    String?
  perda_mensal   String?
  perda_anual    String?
  visit_count    String?
  first_visit_at String?
  last_visit_at  String?
  notes          String? @db.Text
  ai_analysis    String? @db.Text

  // Dados detalhados (JSONB)
  diagnostic_data Json? @db.JsonB
  geo_data        Json? @db.JsonB
  browser_data    Json? @db.JsonB

  adset_id    String?
  adset_name  String?
  ad_id       String?
  ad_name     String?
  page_id     String?
  page_name   String?
  form_id     String?
  form_name   String?
  form_locale String?
  form_status String?

  // Meta Lead Ads — campos extras
  street_address              String?  @db.Text
  zip_code                    String?
  country                     String?
  date_of_birth               String?
  gender                      String?
  cpf                         String?
  marital_status              String?
  first_name                  String?
  last_name                   String?
  work_email                  String?
  work_phone_number           String?
  meta_campaign_id            String?
  meta_campaign_name          String?
  is_organic                  Boolean? @default(false)
  meta_created_time           String?
  custom_disclaimer_responses Json?    @db.JsonB
  military_status             String?
  relationship_status         String?

  contacts        Contacts[]
  card            GenericDndCard?
  campaign        Campaigns?            @relation(fields: [campaignId], references: [campaignId])
  company         Companies?            @relation(fields: [companyId], references: [id])
  custumer        Customers             @relation(fields: [customerId], references: [customerId])
  dndColumn       dndColumn?            @relation(fields: [dndColumnId], references: [id])

  @@unique([email, campaignId, companyId])
  @@unique([phone, campaignId, companyId])
  @@index([companyId])
  @@index([campaignId])
  @@index([sellerId])
  @@index([companyId, campaignId])
  @@index([companyId, campaignId, sellerId])
  @@index([email])
  @@index([phone])
  @@index([created_at])
  @@index([dndColumnId])
  @@index([companyId, campaignId, created_at])
  @@index([companyId, campaignId, sellerId, created_at])
  @@index([source])
  @@index([origin_type])
  @@index([companyId, ad_id, created_at], map: "Leads_companyId_ad_id_created_at_idx")
}

model AdsPerformance {
  idRecord BigInt @id @default(autoincrement()) @map("id_record")

  reportStartDate DateTime @map("report_start_date") @db.Date
  reportEndDate   DateTime @map("report_end_date") @db.Date

  // ✅ FK interna do HDM (coluna no banco: campaignId)
  campaignId String?
  campaign   Campaigns? @relation(fields: [campaignId], references: [campaignId], onDelete: SetNull, onUpdate: Cascade)

  // ✅ apenas string (coluna no banco: externalCampaignId)
  externalCampaignId String?

  // Identificacao Meta
  accountId       String? @map("account_id")
  accountName     String? @map("account_name")
  accountCurrency String? @map("account_currency")

