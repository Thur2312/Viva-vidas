  thumbnailUrl String? @map("thumbnail_url")

  // Video URL do criativo (source do video via Meta Graph API)
  videoUrl String? @map("video_url")

  /// Id do video do criativo no Meta (no Video da Graph API).
  ///
  /// E a IDENTIDADE ESTAVEL da peca criativa. `videoUrl` nao serve para isso: ora e um
  /// mp4 assinado que expira (`&oe=`), ora e a URL de embed montada a partir deste id.
  /// O mesmo video reaparece em varios ad_id, e e por este campo que transcricao e
  /// analise sao penduradas — ver `AdCreativeAnalysis`.
  videoId String? @map("video_id")

  companyId String?    @map("company_id")
  company   Companies? @relation(fields: [companyId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)
  sourceFile String?  @map("source_file")
  dataSource String?  @default("excel") @map("data_source")

  /// Chave canonica do grupo, computada server-side (Postgres GENERATED STORED).
  /// Forma: 'id:<extId>' | 'name:<accountName>|<campaignName>' | 'account:<accountName>' | NULL.
  /// Imutavel por construcao — recalculada quando externalCampaignId/campaign_name/account_name mudam.
  /// NUNCA escrever direto: o Postgres rejeita writes na coluna gerada.
  linkGroupKey String? @map("link_group_key")

  @@index([campaignId, importedAt])
  @@index([externalCampaignId, importedAt])
  @@index([companyId])
  @@index([accountId])
  @@index([dataSource])
  @@index([companyId, adId, reportStartDate, reportEndDate])
  @@index([companyId, adSetId, reportStartDate])
  @@index([companyId, externalCampaignId, reportStartDate])
  @@index([companyId, linkGroupKey])
  @@index([companyId, reportStartDate, adName], map: "ads_performance_company_id_report_start_date_ad_name_idx")
  @@index([companyId, videoId])
  @@map("ads_performance")
}

model AdCreativeAnalysis {
  id String @id @default(uuid())

  companyId String     @map("company_id")
  company   Companies? @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// AdsPerformance.videoId — o no Video do Meta.
  videoId String @map("video_id")

  /// mp4 espelhado no bucket. O `source` do Meta e assinado e expira; sem copia
  /// permanente a transcricao nao e reproduzivel e o player quebra depois de uns dias.
  mediaUrl String? @map("media_url")

  /// Texto cru devolvido pelo Whisper.
  transcript  String? @db.Text
  durationSec Int?    @map("duration_sec")

  /// Campos estruturados: gancho, oferta, prova, cta, publico, objecoes.
  /// Separado de `narrative` para permitir filtrar/agrupar criativos por gancho depois.
  analysisJson Json? @map("analysis_json")

  /// Prosa interpretando transcricao + metricas.
  narrative String? @db.Text

  /// Modelo que escreveu a analise (o agente da empresa, resolvido em tempo de execucao).
  model String?

  status AdCreativeAnalysisStatus @default(PENDING)

  /// Mensagem do erro quando status = FAILED. Fica visivel na UI: "nao consegui" sem
  /// motivo faz o usuario reclicar o botao e pagar de novo pelo mesmo erro.
  error String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, videoId])
  @@index([companyId, status])
  @@map("ad_creative_analysis")
}

model AdsBreakdownPerformance {
  id BigInt @id @default(autoincrement())

  companyId String?    @map("company_id")
  company   Companies? @relation(fields: [companyId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Breakdown dimension
  breakdownType  String @map("breakdown_type")
  breakdownValue String @map("breakdown_value")

  // Period
  reportStartDate DateTime @map("report_start_date") @db.Date
  reportEndDate   DateTime @map("report_end_date") @db.Date

  // Identification
  accountId          String? @map("account_id")
  accountName        String? @map("account_name")
  externalCampaignId String? @map("external_campaign_id")
  campaignName       String? @map("campaign_name")
  adSetId            String? @map("adset_id")
  adSetName          String? @map("adset_name")
  adId               String? @map("ad_id")
  adName             String? @map("ad_name")

  // Core metrics
  impressions BigInt?  @map("impressions")
  reach       BigInt?  @map("reach")
  clicks      BigInt?  @map("clicks")
  linkClicks  BigInt?  @map("link_clicks")
  amountSpent Decimal? @map("amount_spent") @db.Decimal(18, 6)

  // Rates
  ctr Decimal? @map("ctr") @db.Decimal(12, 6)
  cpc Decimal? @map("cpc") @db.Decimal(18, 6)
  cpm Decimal? @map("cpm") @db.Decimal(18, 6)

  // Conversions
  leads   BigInt?  @map("leads")
  results BigInt?  @map("results")
  cpa     Decimal? @map("cpa") @db.Decimal(18, 6)

  // Actions (JSON)
  actions      Json? @map("actions") @db.JsonB
  actionValues Json? @map("action_values") @db.JsonB

  // Video core
  videoPlays           BigInt? @map("video_plays")
  videoThruplayWatched BigInt? @map("video_thruplay_watched")

  // Meta
  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)
